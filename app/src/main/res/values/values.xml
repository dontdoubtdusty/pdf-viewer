<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Lean PDF</string>

    <color name="reader_bg">#2B2B2B</color>
    <color name="icon_bg">#D9443A</color>

    <!-- Window background matches the reader so cold start shows no white flash. -->
    <style name="Reader" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/reader_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
